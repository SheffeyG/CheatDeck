{
  "name": "cheatdeck",
  "type": "module",
  "version": "1.2.1",
  "description": "A launch options manager allows you to run games with cheats and trainers.",
  "scripts": {
    "build": "rollup -c",
    "watch": "rollup -c -w",
    "lint": "biome check src tests vitest.config.ts",
    "lint:frontend": "pnpm run lint",
    "format": "biome check --write src",
    "typecheck": "tsc --noEmit",
    "check": "pnpm run lint && pnpm run typecheck && pnpm run test && pnpm run build",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SheffeyG/CheatDeck.git"
  },
  "keywords": [
    "decky",
    "plugin",
    "steam-deck",
    "deck"
  ],
  "author": "SheffeyG",
  "license": "GPL-3.0-or-later",
  "bugs": {
    "url": "https://github.com/SheffeyG/CheatDeck/issues"
  },
  "homepage": "https://github.com/SheffeyG/CheatDeck#readme",
  "devDependencies": {
    "@biomejs/biome": "^2.5.3",
    "@decky/rollup": "^1.0.2",
    "@decky/ui": "^4.11.1",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "@types/react-router": "^5.1.20",
    "@types/uuid": "^10.0.0",
    "@types/webpack": "^5.28.5",
    "rollup": "^4.54.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@decky/api": "^1.1.3",
    "qrcode.react": "^4.1.0",
    "react-icons": "^5.3.0",
    "tslib": "^2.8.0",
    "uuid": "^10.0.0"
  },
  "packageManager": "pnpm@11.5.0"
}
